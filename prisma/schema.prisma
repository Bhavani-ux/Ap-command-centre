generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(255)
  legalName      String?   @map("legal_name") @db.VarChar(255)
  taxId          String?   @map("tax_id") @db.VarChar(50)
  addressLine1   String?   @map("address_line1") @db.VarChar(255)
  addressLine2   String?   @map("address_line2") @db.VarChar(255)
  city           String?   @db.VarChar(100)
  state          String?   @db.VarChar(100)
  postalCode     String?   @map("postal_code") @db.VarChar(20)
  country        String?   @db.VarChar(2)
  currency       String    @default("USD") @db.VarChar(3)
  fiscalYearEnd  String?   @map("fiscal_year_end") @db.VarChar(5)
  settings       Json?
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  users          User[]
  vendors        Vendor[]
  departments    Department[]
  glAccounts     GLAccount[]    @relation("CompanyGLAccounts")
  invoices       Invoice[]
  payments       Payment[]
  roles          Role[]
  auditLogs      AuditLog[]

  @@index([isActive])
  @@map("companies")
}

model User {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  email         String    @unique @db.VarChar(255)
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String    @map("last_name") @db.VarChar(100)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  departmentId  String?   @map("department_id")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company            Company           @relation(fields: [companyId], references: [id])
  department         Department?       @relation(fields: [departmentId], references: [id])
  userRoles          UserRole[]
  invoicesCreated    Invoice[]         @relation("InvoiceCreator")
  approvals          Approval[]
  paymentsCreated    Payment[]         @relation("PaymentCreator")
  paymentsApproved   Payment[]         @relation("PaymentApprover")
  attachmentsUploaded Attachment[]
  comments           Comment[]
  rolesAssigned      UserRole[]        @relation("RoleAssigner")
  departmentsManaged Department[]      @relation("DepartmentManager")

  @@index([companyId])
  @@index([email])
  @@index([isActive])
  @@index([departmentId])
  @@map("users")
}

model Role {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  name          String    @db.VarChar(100)
  description   String?   @db.Text
  permissions   Json
  isSystemRole  Boolean   @default(false) @map("is_system_role")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company       Company     @relation(fields: [companyId], references: [id])
  userRoles     UserRole[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model UserRole {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  roleId      String    @map("role_id")
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  assignedBy  String?   @map("assigned_by")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner    User?     @relation("RoleAssigner", fields: [assignedBy], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Vendor {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  vendorCode        String    @map("vendor_code") @db.VarChar(50)
  name              String    @db.VarChar(255)
  legalName         String?   @map("legal_name") @db.VarChar(255)
  taxId             String?   @map("tax_id") @db.VarChar(50)
  paymentTerms      String?   @map("payment_terms") @db.VarChar(50)
  paymentMethod     String?   @map("payment_method") @db.VarChar(50)
  currency          String    @default("USD") @db.VarChar(3)
  addressLine1      String?   @map("address_line1") @db.VarChar(255)
  addressLine2      String?   @map("address_line2") @db.VarChar(255)
  city              String?   @db.VarChar(100)
  state             String?   @db.VarChar(100)
  postalCode        String?   @map("postal_code") @db.VarChar(20)
  country           String?   @db.VarChar(2)
  phone             String?   @db.VarChar(20)
  email             String?   @db.VarChar(255)
  website           String?   @db.VarChar(255)
  bankName          String?   @map("bank_name") @db.VarChar(255)
  bankAccountNumber String?   @map("bank_account_number") @db.VarChar(100)
  bankRoutingNumber String?   @map("bank_routing_number") @db.VarChar(50)
  bankSwiftCode     String?   @map("bank_swift_code") @db.VarChar(20)
  notes             String?   @db.Text
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company           Company          @relation(fields: [companyId], references: [id])
  contacts          VendorContact[]
  invoices          Invoice[]

  @@unique([companyId, vendorCode])
  @@index([companyId])
  @@index([companyId, vendorCode])
  @@index([name])
  @@index([isActive])
  @@map("vendors")
}

model VendorContact {
  id          String    @id @default(uuid())
  vendorId    String    @map("vendor_id")
  firstName   String    @map("first_name") @db.VarChar(100)
  lastName    String    @map("last_name") @db.VarChar(100)
  email       String?   @db.VarChar(255)
  phone       String?   @db.VarChar(20)
  title       String?   @db.VarChar(100)
  isPrimary   Boolean   @default(false) @map("is_primary")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([vendorId, isPrimary])
  @@map("vendor_contacts")
}

model Department {
  id          String     @id @default(uuid())
  companyId   String     @map("company_id")
  code        String     @db.VarChar(50)
  name        String     @db.VarChar(255)
  parentId    String?    @map("parent_id")
  managerId   String?    @map("manager_id")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  company          Company          @relation(fields: [companyId], references: [id])
  parent           Department?      @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children         Department[]     @relation("DepartmentHierarchy")
  manager          User?            @relation("DepartmentManager", fields: [managerId], references: [id])
  users            User[]
  invoices         Invoice[]
  invoiceLineItems InvoiceLineItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
  @@index([companyId, code])
  @@map("departments")
}

model GLAccount {
  id             String     @id @default(uuid())
  companyId      String     @map("company_id")
  accountNumber  String     @map("account_number") @db.VarChar(50)
  accountName    String     @map("account_name") @db.VarChar(255)
  accountType    String     @map("account_type") @db.VarChar(50)
  parentId       String?    @map("parent_id")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  company          Company          @relation("CompanyGLAccounts", fields: [companyId], references: [id])
  parent           GLAccount?       @relation("GLAccountHierarchy", fields: [parentId], references: [id])
  children         GLAccount[]      @relation("GLAccountHierarchy")
  invoiceLineItems InvoiceLineItem[]

  @@unique([companyId, accountNumber])
  @@index([companyId])
  @@index([companyId, accountNumber])
  @@index([parentId])
  @@index([accountType])
  @@map("gl_accounts")
}

model Invoice {
  id              String     @id @default(uuid())
  companyId       String     @map("company_id")
  invoiceNumber   String     @map("invoice_number") @db.VarChar(100)
  vendorId        String     @map("vendor_id")
  departmentId    String?    @map("department_id")
  invoiceDate     DateTime   @map("invoice_date") @db.Date
  dueDate         DateTime   @map("due_date") @db.Date
  receivedDate    DateTime   @default(now()) @map("received_date") @db.Date
  paymentTerms    String?    @map("payment_terms") @db.VarChar(50)
  currency        String     @default("USD") @db.VarChar(3)
  exchangeRate    Decimal    @default(1.0) @map("exchange_rate") @db.Decimal(12, 6)
  subtotal        Decimal    @db.Decimal(15, 2)
  taxAmount       Decimal    @default(0) @map("tax_amount") @db.Decimal(15, 2)
  discountAmount  Decimal    @default(0) @map("discount_amount") @db.Decimal(15, 2)
  totalAmount     Decimal    @map("total_amount") @db.Decimal(15, 2)
  amountPaid      Decimal    @default(0) @map("amount_paid") @db.Decimal(15, 2)
  amountDue       Decimal    @map("amount_due") @db.Decimal(15, 2)
  status          String     @default("draft") @db.VarChar(50)
  approvalStatus  String     @default("pending") @map("approval_status") @db.VarChar(50)
  paymentStatus   String     @default("unpaid") @map("payment_status") @db.VarChar(50)
  description     String?    @db.Text
  notes           String?    @db.Text
  poNumber        String?    @map("po_number") @db.VarChar(100)
  createdBy       String?    @map("created_by")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id])
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id])
  creator         User?            @relation("InvoiceCreator", fields: [createdBy], references: [id])
  lineItems       InvoiceLineItem[]
  approvals       Approval[]
  paymentItems    PaymentItem[]
  attachments     Attachment[]
  comments        Comment[]

  @@unique([companyId, invoiceNumber, vendorId])
  @@index([companyId])
  @@index([vendorId])
  @@index([departmentId])
  @@index([companyId, invoiceNumber])
  @@index([status])
  @@index([approvalStatus])
  @@index([paymentStatus])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([createdBy])
  @@index([poNumber])
  @@map("invoices")
}

model InvoiceLineItem {
  id            String     @id @default(uuid())
  invoiceId     String     @map("invoice_id")
  lineNumber    Int        @map("line_number")
  description   String     @db.Text
  quantity      Decimal    @default(1) @db.Decimal(12, 4)
  unitPrice     Decimal    @map("unit_price") @db.Decimal(15, 2)
  amount        Decimal    @db.Decimal(15, 2)
  glAccountId   String?    @map("gl_account_id")
  departmentId  String?    @map("department_id")
  taxCode       String?    @map("tax_code") @db.VarChar(20)
  taxAmount     Decimal    @default(0) @map("tax_amount") @db.Decimal(15, 2)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  invoice       Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  glAccount     GLAccount?  @relation(fields: [glAccountId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])

  @@unique([invoiceId, lineNumber])
  @@index([invoiceId])
  @@index([glAccountId])
  @@index([departmentId])
  @@map("invoice_line_items")
}

model Approval {
  id          String     @id @default(uuid())
  invoiceId   String     @map("invoice_id")
  approverId  String     @map("approver_id")
  level       Int
  status      String     @default("pending") @db.VarChar(50)
  approvedAt  DateTime?  @map("approved_at")
  comments    String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  approver    User       @relation(fields: [approverId], references: [id])

  @@unique([invoiceId, approverId, level])
  @@index([invoiceId])
  @@index([approverId])
  @@index([status])
  @@index([level])
  @@map("approvals")
}

model Payment {
  id              String     @id @default(uuid())
  companyId       String     @map("company_id")
  paymentNumber   String     @map("payment_number") @db.VarChar(100)
  paymentDate     DateTime   @map("payment_date") @db.Date
  paymentMethod   String     @map("payment_method") @db.VarChar(50)
  bankAccount     String?    @map("bank_account") @db.VarChar(100)
  referenceNumber String?    @map("reference_number") @db.VarChar(100)
  totalAmount     Decimal    @map("total_amount") @db.Decimal(15, 2)
  currency        String     @default("USD") @db.VarChar(3)
  status          String     @default("draft") @db.VarChar(50)
  notes           String?    @db.Text
  createdBy       String?    @map("created_by")
  approvedBy      String?    @map("approved_by")
  approvedAt      DateTime?  @map("approved_at")
  processedAt     DateTime?  @map("processed_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  company         Company        @relation(fields: [companyId], references: [id])
  creator         User?          @relation("PaymentCreator", fields: [createdBy], references: [id])
  approver        User?          @relation("PaymentApprover", fields: [approvedBy], references: [id])
  paymentItems    PaymentItem[]

  @@unique([companyId, paymentNumber])
  @@index([companyId])
  @@index([companyId, paymentNumber])
  @@index([paymentDate])
  @@index([status])
  @@index([createdBy])
  @@map("payments")
}

model PaymentItem {
  id            String     @id @default(uuid())
  paymentId     String     @map("payment_id")
  invoiceId     String     @map("invoice_id")
  amount        Decimal    @db.Decimal(15, 2)
  discountTaken Decimal    @default(0) @map("discount_taken") @db.Decimal(15, 2)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  payment       Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice       Invoice    @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_items")
}

model Attachment {
  id          String     @id @default(uuid())
  invoiceId   String     @map("invoice_id")
  fileName    String     @map("file_name") @db.VarChar(255)
  filePath    String     @map("file_path") @db.VarChar(500)
  fileSize    BigInt     @map("file_size")
  fileType    String?    @map("file_type") @db.VarChar(100)
  uploadedBy  String?    @map("uploaded_by")
  uploadedAt  DateTime   @default(now()) @map("uploaded_at")

  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  uploader    User?      @relation(fields: [uploadedBy], references: [id])

  @@index([invoiceId])
  @@index([uploadedBy])
  @@map("attachments")
}

model Comment {
  id          String     @id @default(uuid())
  invoiceId   String     @map("invoice_id")
  userId      String     @map("user_id")
  content     String     @db.Text
  isInternal  Boolean    @default(true) @map("is_internal")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id])

  @@index([invoiceId])
  @@index([userId])
  @@index([createdAt])
  @@map("comments")
}

model AuditLog {
  id          String     @id @default(uuid())
  companyId   String     @map("company_id")
  entityType  String     @map("entity_type") @db.VarChar(100)
  entityId    String     @map("entity_id")
  action      String     @db.VarChar(50)
  userId      String?    @map("user_id")
  changes     Json?
  ipAddress   String?    @map("ip_address") @db.VarChar(45)
  userAgent   String?    @map("user_agent") @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at")

  company     Company    @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
