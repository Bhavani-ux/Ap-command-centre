# Database
DATABASE_URL="postgresql://postgres:1234@localhost:5432/ap_command_centre?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"
JWT_ISSUER="ap-command-centre"
JWT_AUDIENCE="ap-command-centre-api"

# Password Configuration
PASSWORD_SALT_ROUNDS="10"

# CORS
CORS_ORIGIN="http://localhost:5175"

# Server
PORT="3001"
NODE_ENV="development"

# Email Intake Configuration
EMAIL_INTAKE_USER="invoices@yourcompany.com"
EMAIL_INTAKE_PASSWORD="your-email-password"
EMAIL_INTAKE_HOST="imap.gmail.com"
EMAIL_INTAKE_PORT="993"
EMAIL_INTAKE_TLS="true"

# Email Processing
EMAIL_POLL_INTERVAL="300000"
EMAIL_BATCH_SIZE="10"
EMAIL_MAX_RETRIES="3"
EMAIL_RETRY_DELAY="60000"

# Email Folders
EMAIL_INBOX_FOLDER="INBOX"
EMAIL_PROCESSED_FOLDER="INBOX/Processed"
EMAIL_FAILED_FOLDER="INBOX/Failed"

# Email Security
EMAIL_ALLOWED_SENDERS=""
EMAIL_ALLOWED_DOMAINS="trusted-vendor.com,another-vendor.com"
EMAIL_MAX_ATTACHMENT_SIZE="10485760"

# OCR Configuration
OCR_PROVIDER="tesseract"
OCR_CONFIDENCE="0.7"

# Storage
STORAGE_PATH="./storage/email-intake"

# AWS (Optional - for Textract)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
