# Database
DATABASE_URL="postgresql://username:password@localhost:5432/ap_command_centre"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Microsoft Azure AD Configuration (for SSO)
# Get these from Azure Portal: https://portal.azure.com > Azure Active Directory > App registrations
AZURE_CLIENT_ID="your-azure-app-client-id"
AZURE_CLIENT_SECRET="your-azure-app-client-secret"
AZURE_TENANT_ID="your-azure-tenant-id-or-common"
AZURE_REDIRECT_URI="http://localhost:3001/api/auth/microsoft/callback"

# Server
PORT=3001
